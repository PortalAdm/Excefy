{
    "$schema": "https://unpkg.com/@camunda/element-templates-json-schema/resources/schema.json",
    "name": "Chatgpt Connector",
    "id": "chatgpt-connector",
    "appliesTo": ["bpmn:ServiceTask"],
    "icon": {
      "contents": "data:image/jpeg;base64,"
    },
    "scopes": [
      {
        "type": "camunda:Connector",
        "properties": [
          {
            "label": "ConnectorId",
            "type": "Hidden",
            "value": "ChatgptConnector",
            "binding": {
                "type": "property",
              "name": "connectorId",
              "source": "ChatgptConnector"
            }
          },
          {
            "label": "Pegar resposta",
            "type": "Dropdown",
            "value": "action",
            "choices": [
              { "name": "Resposta chatgpt", "value": "get_chatgpt_response" }
            ],
            "binding": {
              "type": "camunda:inputParameter",
              "name": "action"
            },
            "constraints": {
                "notEmpty": true,
                "pattern": {
                    "message": "Selecione o método."
                }
            }
          },
          {
            "label": "Prompt",
            "type": "String",
            "value": "",
            "binding": {
              "type": "camunda:inputParameter",
              "name": "prompt"
            }
          },
          {
            "label": "API Key",
            "type": "String",
            "value": "",
            "binding": {
              "type": "camunda:inputParameter",
              "name": "apiKey"
            }
          },
          {
            "label": "Modelo",
            "type": "String",
            "value": "",
            "binding": {
              "type": "camunda:inputParameter",
              "name": "model"
            }
          },
          {
            "label": "Resposta do Chatgpt",
            "type": "Hidden",
            "value": "ChatGptResponse",
            "binding": {
              "type": "camunda:outputParameter",
              "source": "${ChatGptResponse}"
            }
          }
        ]
      }
    ],
    "properties": []
  }
