{
    "$schema": "https://unpkg.com/@camunda/element-templates-json-schema/resources/schema.json",
    "name": "Twilio Connector",
    "id": "twilio-connector",
    "appliesTo": ["bpmn:ServiceTask"],
    "icon": {
      "contents": "data:image/jpeg;base64,"
    },
    "scopes": [
      {
        "type": "camunda:Connector",
        "properties": [
          {
            "label": "ConnectorId",
            "type": "Hidden",
            "value": "TwilioConnector",
            "binding": {
                "type": "property",
              "name": "connectorId",
              "source": "TwilioConnector"
            }
          },
          {
            "label": "Ação",
            "type": "Dropdown",
            "value": "action",
            "choices": [
              { "name": "Enviar no SMS", "value": "send_sms" },
              { "name": "Enviar no Whatsapp", "value": "send_whatsapp" }
            ],
            "binding": {
              "type": "camunda:inputParameter",
              "name": "action"
            },
            "constraints": {
                "notEmpty": true,
                "pattern": {
                    "message": "Selecione um método"
                }
            }
          },
          {
            "label": "Account Sid",
            "type": "String",
            "value": "",
            "binding": {
              "type": "camunda:inputParameter",
              "name": "accountSid"
            }
          },
          {
            "label": "Auth Token",
            "type": "String",
            "value": "",
            "binding": {
              "type": "camunda:inputParameter",
              "name": "authToken"
            }
          },
          {
            "label": "From Number",
            "type": "String",
            "value": "",
            "binding": {
              "type": "camunda:inputParameter",
              "name": "fromNumber"
            }
          },
          {
            "label": "To Number",
            "type": "String",
            "value": "",
            "binding": {
              "type": "camunda:inputParameter",
              "name": "toNumber"
            }
          },
          {
            "label": "Message",
            "type": "String",
            "value": "",
            "binding": {
              "type": "camunda:inputParameter",
              "name": "message"
            }
          }
        ]
      }
    ],
    "properties": []
  }
